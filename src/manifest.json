{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "offscreen",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.primevideo.com/*",
    "https://*.hbomax.com/*",
    "https://tv.apple.com/*",
    "https://*.tv.apple.com/*",
    "https://*.itunes.apple.com/*",
    "https://www.viki.com/*",
    "https://assets.languagepod101.com/*",
    "https://cdn.innovativelanguage.com/*",
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://download.wikdict.com/*",
    "https://korean.dict.naver.com/api3/koko/search*",
    "https://dict-dn.pstatic.net/naver/dic/naverdic/krdic/sound/*",
    "https://audio1.spanishdict.com/audio*",
    "https://jotoba.de/*",
    "https://jisho.org/*",
    "https://*.nflxvideo.net/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://www.mdbg.net/*",
    "https://cantonese.org/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "inject-netflix.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "inject-disney.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*"
      ],
      "js": [
        "inject-prime.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://play.hbomax.com/*",
        "https://www.hbomax.com/*"
      ],
      "js": [
        "inject-max.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tv.apple.com/*"
      ],
      "js": [
        "inject-apple.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.viki.com/*"
      ],
      "js": [
        "inject-viki.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://play.hbomax.com/*",
        "https://www.hbomax.com/*",
        "https://tv.apple.com/*",
        "https://www.viki.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "subs.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "action": {
    "default_popup": "action.html",
    "default_title": "Libregaku",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
